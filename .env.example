# TMDB (required for Add Movie and Watchlist search)
TMDB_API_KEY=

# OMDb (optional - enriches IMDb and Rotten Tomatoes ratings)
OMDB_API_KEY=

# App auth (required in production - server-side only)
APP_PIN=
APP_SESSION_SECRET=

# Stremio (optional - server-side watched sync)
STREMIO_AUTH_KEY=
# STREMIO_API_BASE_URL=https://api.strem.io/api

# Supabase session middleware (optional)
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Prisma/Postgres (required for Watchlists, Awaiting Review and Stremio sync)
# DATABASE_URL=
# DIRECT_URL=
