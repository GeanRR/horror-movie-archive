// Horror Movie Archive — Prisma schema
// Add models when implementing features. Requires DATABASE_URL and DIRECT_URL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Movie {
  id                      String   @id @default(cuid())
  tmdbId                  Int      @unique
  imdbId                  String?  @unique
  displayTitle            String
  originalTitle           String
  titlePt                 String
  year                    String
  posterUrl               String?
  director                String
  country                 String
  distributor             String
  runtime                 Int?
  releaseDate             String
  synopsis                String
  cast                    Json
  crew                    Json
  genres                  Json
  subgenres               Json
  imdbScore               Float?
  rottenTomatoesScore     Float?
  reviewScore             Float?
  stars                   Int
  badgeId                 String?
  badgeOverrideEnabled    Boolean  @default(false)
  watchedDate             String
  rewatchHistory          Json
  bestOfYear              Boolean  @default(false)
  assignedLists           Json
  metadataSourceSnapshot  String?
  metadataLastRefreshedAt String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@index([year])
  @@index([bestOfYear])
  @@index([badgeId])
}

model Watchlist {
  id        String          @id @default(cuid())
  name      String
  items     WatchlistItem[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
}

model WatchlistItem {
  id           String    @id @default(cuid())
  watchlistId  String
  watchlist    Watchlist @relation(fields: [watchlistId], references: [id], onDelete: Cascade)
  tmdbId       Int?
  imdbId       String?
  displayTitle String
  year         String
  posterUrl    String?
  position     Int
  createdAt    DateTime  @default(now())

  @@unique([watchlistId, tmdbId])
  @@unique([watchlistId, imdbId])
  @@index([watchlistId, position])
  @@index([tmdbId])
  @@index([imdbId])
}

enum AwaitingReviewItemStatus {
  PENDING
  ADDED
  IGNORED
  DUPLICATE
}

model AwaitingReviewItem {
  id          String                   @id @default(cuid())
  imdbId      String                   @unique
  tmdbId      Int?
  displayTitle String
  year        String?
  posterUrl   String?
  watchedAt   DateTime?
  source      String
  status      AwaitingReviewItemStatus @default(PENDING)
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt
  resolvedAt  DateTime?

  @@index([status, watchedAt])
  @@index([tmdbId])
}

model ReleaseCalendarItem {
  id                      String   @id @default(cuid())
  tmdbId                  Int?
  imdbId                  String?
  displayTitle            String
  originalTitle           String
  titlePt                 String
  year                    String
  posterUrl               String?
  director                String
  country                 String
  distributor             String
  runtime                 Int?
  releaseDate             String
  synopsis                String
  cast                    Json
  crew                    Json
  genres                  Json
  subgenres               Json
  imdbScore               Float?
  rottenTomatoesScore     Float?
  releaseDates            Json
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  metadataSourceSnapshot  String?
  metadataLastRefreshedAt String?

  @@unique([tmdbId])
  @@unique([imdbId])
  @@index([year])
}

model StremioWatchedSyncState {
  id                      String    @id @default("default")
  hasCompletedInitialSync Boolean   @default(false)
  lastSyncedAt            DateTime?
  lastSyncError           String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
}

model StremioWatchedState {
  imdbId             String   @id
  type               String
  name               String?
  lastWatched        DateTime?
  timesWatched       Int?
  timeWatched        Int?
  timeOffset         Int?
  overallTimeWatched Int?
  flaggedWatched     Boolean?
  duration           Int?
  watched            Boolean?
  isCompleted        Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([isCompleted])
  @@index([lastWatched])
}

model StremioWatchedEvent {
  id               String   @id @default(cuid())
  imdbId           String
  name             String?
  detectedAt       DateTime @default(now())
  lastWatched      DateTime?
  timesWatched     Int?
  completionSource String
  previous         Json?
  current          Json

  @@index([detectedAt])
  @@index([imdbId])
}
